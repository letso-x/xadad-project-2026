# Mzukulu QMS - SMTP settings for sending MFA codes (optional).
# Fill in a Gmail address + 16-char App Password to enable email codes.
# Admins skip MFA, so this is only needed for standard users.

Smtp.Host=smtp.gmail.com
Smtp.Port=587
Smtp.EnableSsl=true
Smtp.User=YOUR_GMAIL_ADDRESS
Smtp.Password=YOUR_16_CHAR_APP_PASSWORD
Smtp.From=YOUR_GMAIL_ADDRESS
Smtp.FromName=Mzukulu QMS
