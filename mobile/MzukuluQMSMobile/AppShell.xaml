<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MzukuluQMSMobile.AppShell"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:local="clr-namespace:MzukuluQMSMobile"
 Title="MzukuluQMSMobile"
    
    FlyoutBehavior="Flyout"
    FlyoutWidth="280"
    FlyoutBackgroundColor="#091422">

    <!-- THE STYLE SYSTEM: Targets the dynamic visual states safely inside shell template structures -->
    <Shell.Resources>
        <ResourceDictionary>
            <Style TargetType="Layout" Class="FlyoutItemStyle">
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <!-- Only selected navigation items turn orange -->
                            <VisualState x:Name="Selected">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#A23C2A" />
                                </VisualState.Setters>
                            </VisualState>
                            <!-- Inactive navigation rows remain completely transparent -->
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <!-- 1. UPPER FIXED HEADER (Branding) -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="0, 24, 0, 12" BackgroundColor="#091422">
            <Grid ColumnDefinitions="Auto, *" Padding="16, 0, 16, 16" ColumnSpacing="12">
                <Border Grid.Column="0" HeightRequest="36" WidthRequest="36" BackgroundColor="#A23C2A" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>
                    <Label Text="MZ" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Mzukulu QMS" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                    <Label Text="QUALITY CONTROL SYSTEM" TextColor="#53687E" FontSize="10" CharacterSpacing="1"/>
                </VerticalStackLayout>
            </Grid>
            <BoxView HeightRequest="1" BackgroundColor="#112235" />

            <!-- Structural Category Label Anchor -->
            <Label Text="OPERATIONS" TextColor="#42556B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" Padding="16, 16, 16, 4"/>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- 2. REUSABLE LINK TEMPLATE: Automatically manages icons and orange highlight toggling safely -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Border Margin="12, 2, 12, 2" StrokeThickness="0" StrokeShape="RoundRectangle 8">

                <!-- The Visual State Manager directly checks selection states using the Style Class definition -->
                <Grid StyleClass="FlyoutItemStyle" ColumnDefinitions="Auto, *" Padding="12, 10">
                    <!-- Icon Text Binding Asset -->
                    <Label Grid.Column="0" Text="{Binding FlyoutIcon}" Margin="0,0,12,0" VerticalOptions="Center"/>
                    <!-- Menu Link String Binding -->
                    <Label Grid.Column="1" Text="{Binding Title}" TextColor="White" FontSize="14" VerticalOptions="Center"/>
                </Grid>

            </Border>
        </DataTemplate>
    </Shell.ItemTemplate>

    <!-- 3. GENUINE APPLICATION NAVIGATION LINK CONFIGURATION -->
    <FlyoutItem Title="Dashboard" FlyoutIcon="🎛️">
        <ShellContent Route="DashboardPage" ContentTemplate="{DataTemplate local:Dashboard}"/>
    </FlyoutItem>

    <FlyoutItem Title="Clients" FlyoutIcon="👥">
        <ShellContent Route="ClientsPage" ContentTemplate="{DataTemplate local:ClientsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Projects" FlyoutIcon="📁">
        <ShellContent Route="ProjectsPage" ContentTemplate="{DataTemplate local:ProjectsPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Form Library" FlyoutIcon="📚">
        <ShellContent Route="FormLibraryPage" ContentTemplate="{DataTemplate local:FormLibraryPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Search" FlyoutIcon="🔍">
        <ShellContent Route="SearchPage" ContentTemplate="{DataTemplate local:SearchPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Checklist Builder" FlyoutIcon="🛠️">
        <ShellContent Route="ChecklistBuilderPage" ContentTemplate="{DataTemplate local:ChecklistBuilderPage}"/>
    </FlyoutItem>

    <!-- 4. LOWER FIXED FOOTER CONTAINER (Pinned User Profile Box) -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout BackgroundColor="#060E18">
            <BoxView HeightRequest="1" BackgroundColor="#112235"/>
            <Grid ColumnDefinitions="Auto, *" Padding="16, 16, 16, 20" ColumnSpacing="12">
                <Border Grid.Column="0" HeightRequest="36" WidthRequest="36" BackgroundColor="#1B324D" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                    <Label Text="SN" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="S. Ndlovu" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                    <Label Text="ADMIN" TextColor="#53687E" FontSize="10" FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
