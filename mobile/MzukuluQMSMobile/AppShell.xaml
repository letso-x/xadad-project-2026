<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MzukuluQMSMobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MzukuluQMSMobile"
    Title="MzukuluQMSMobile">

    <ShellContent Title="Dashboard" Route="DashboardPage" ContentTemplate="{DataTemplate local:Dashboard}"/>
    <ShellContent Title="Clients" Route="ClientsPage" ContentTemplate="{DataTemplate local:ClientsPage}"/>
    <ShellContent Title="Projects" Route="ProjectsPage" ContentTemplate="{DataTemplate local:ProjectsPage}"/>
    <ShellContent Title="FormLibrary" Route="FormLibraryPage" ContentTemplate="{DataTemplate local:FormLibraryPage}"/>
    <ShellContent Title="Search" Route="SearchPage" ContentTemplate="{DataTemplate local:SearchPage}"/>
    <ShellContent Title="Checklist Builder" Route="ChecklistBuilderPage" ContentTemplate="{DataTemplate local:ChecklistBuilderPage}"/>
    
    <!-- CUSTOM FLYOUT SIDEBAR TEMPLATE -->
    <Shell.FlyoutContentTemplate>
        <DataTemplate>

            <Grid RowDefinitions="*, Auto" BackgroundColor="#091422">

                <ScrollView Grid.Row="0">
                    <VerticalStackLayout Padding="0, 24, 0, 24">
                      
                        <!-- MZUKULU HEADER -->
                        <Grid ColumnDefinitions="Auto, *" Padding="16, 0, 16, 24" ColumnSpacing="12">
                            <Border Grid.Column="0" HeightRequest="36" WidthRequest="36" BackgroundColor="#A23C2A" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label Text="MZ" TextColor="White" FontAttributes="Bold" FontSize="13" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="Mzukulu QMS" TextColor="White" FontAttributes="Bold" FontSize="15"/>
                                <Label Text="QUALITY CONTROL SYSTEM" TextColor="#53687E" FontSize="15"/>
                                
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="OPERATIONS" TextColor="#42556B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" Padding="12, 10"/>
                        
                        <!--MENU ITEMS-->
                        
                        <Border Margin="12, 2, 12, 2" BackgroundColor="#A23C2A"  StrokeThickness="0" Padding="12, 10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=GoToAsyncCommand}" CommandParameter="///Dashboard"/>
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="Auto, *">
                                <Label Grid.Column="0" Text="" Margin="0,0,12,0" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="Dashboard" TextColor="White" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"/>
                            </Grid>

                        </Border>

                        <VerticalStackLayout Padding="12, 4">
                            <!--Clients Link-->
                            <Grid ColumnDefinitions="Auto, *" Padding="12, 10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=GoToAsyncCommand}" CommandParameter="///ClientsPage"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="👥" Margin="0,0,12,0" TextColor ="#7D93A8"/>
                                <Label Grid.Column="1" Text="Clients" TextColor="#9EB1C2" FontSize="14"/>
                            </Grid>
                            
                            <!--Projects Link-->
                            <Grid ColumnDefinitions="Auto, *" Padding="12, 10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=GoToAsyncCommand}" CommandParameter="///ProjectsPage"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="📁" Margin="0,0,12,0" TextColor="#7D93A8"></Label>
                                <Label Grid.Column="1" Text="Projects" TextColor="#9EB1C2" FontSize="14"></Label>
                            </Grid>
                            
                            <!-- Form Library Link -->
                            <Grid ColumnDefinitions="Auto, *" Padding="12, 10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=GoToASyncCommand}" CommandParameter="///FormLibraryPage"></TapGestureRecognizer>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="📚" Margin="0,0,12,0" TextColor="#7D93A8"></Label>
                                <Label Grid.Column="1" Text="Form Library" TextColor="#9EB1C2" FontSize="14"></Label>
                                
                            </Grid>
                            
                            <!-- Search Link -->

                            <Grid ColumnDefinitions="Auto, *" Padding="12, 10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=GoToASyncCommand}" CommandParameter="///SearchPage"></TapGestureRecognizer>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="🔍" Margin="0,0,12,0" TextColor="#7D93A8"></Label>
                                <Label Grid.Column="1" Text="Search" TextColor="#9EB1C2" FontSize="14"></Label>

                            </Grid>

                        </VerticalStackLayout>


                        <!-- ADMINISTRATION SECTION -->
                        <Label Text="ADMINISTRATION" TextColor="#42556B" FontSize="11" FontAttributes="Bold" CharacterSpacing="1" Padding="16, 16, 16, 8" />

                        <VerticalStackLayout Padding="12, 0">
                            <!-- Checklist Builder Link -->
                            <Grid ColumnDefinitions="Auto, *" Padding="12, 10">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type Shell}}, Path=GoToAsyncCommand}" CommandParameter="///ChecklistBuilderPage"/>
                                </Grid.GestureRecognizers>
                                <Label Grid.Column="0" Text="🛠" Margin="0,0,12,0" TextColor="#7D93A8"/>
                                <Label Grid.Column="1" Text="Checklist Builder" TextColor="#9EB1C2" FontSize="14"/>
                            </Grid>
                        </VerticalStackLayout>


                    </VerticalStackLayout>
                </ScrollView>
                <!-- 2. LOWER FIXED FOOTER CONTAINER (User Profile Box) -->
                <VerticalStackLayout Grid.Row="1" BackgroundColor="#060E18">
                    <BoxView HeightRequest="1" BackgroundColor="#112235"/>
                    <Grid ColumnDefinitions="Auto, *" Padding="16, 16, 16, 20" ColumnSpacing="12">
                        <!-- User Circle Avatar -->
                        <Border Grid.Column="0" HeightRequest="36" WidthRequest="36" BackgroundColor="#1B324D" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                            <Label Text="SN" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <!-- Profile Metadata strings -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="S. Ndlovu" TextColor="White" FontAttributes="Bold" FontSize="14"/>
                            <Label Text="ADMIN" TextColor="#53687E" FontSize="10" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
                
            </Grid>    
        </DataTemplate>
    </Shell.FlyoutContentTemplate>



</Shell>
