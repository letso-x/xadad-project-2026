<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MzukuluQMSMobile.MainPage">

    <Grid BackgroundColor="#061220">

        <Grid.Background>
            
            <RadialGradientBrush Center="0.3,0.2" Radius="0.6">
                <GradientStop Color="#153252" Offset="0.0"/>
                <GradientStop Color="#0B1B2B" Offset="0.6"/>

            </RadialGradientBrush>
        </Grid.Background>
        <!-- Main Card Container centered on top of the gradient -->
        <Border WidthRequest="360"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="#0C1926">

            <!-- Card Content Stack Layout -->

            <VerticalStackLayout Padding="24, 28, 24, 20" Spacing="12">

                <Border HeightRequest="40"
                        WidthRequest="40"
                        HorizontalOptions="Start"
                        BackgroundColor="#A23C2A"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle">
                    <Label Text="MZ"
                           TextColor="White"
                           FontAttributes="Bold"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>

                <!-- Title Strings -->
                
                <VerticalStackLayout Spacing="2">
                    <Label Text="Mzukulu QC"
                           TextColor="White"
                           FontSize="20"
                           FontAttributes="Bold"/>
                    <Label Text="Quality Control Management System"
                           TextColor="#7D98B3"
                           FontSize="12"/>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
            <!-- LOWER SECTION: White Account Picker Panel -->

            <Border BackgroundColor="white"
                    StrokeThickness= "0"
                    StrokeShape="RoundRectangle 0,0,16,16"
                    Padding="24, 24, 24, 28">
                <VerticalStackLayout Spacing="16">
                    <Label Text="SELECT A DEMO ACCOUNT"
                           TextColor="#A23C2A"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           Margin="0,0,0,4"/>

            <!-- Admin Account Option Card -->
                    <Border Stroke="#EAEFF5" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16, 12">
                     <!--   <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAdminSelected" />
                        </Border.GestureRecognizers> -->
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Admin Demo — S. Ndlovu" TextColor="#0B1B2B" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="Full access: clients, projects, checklist builder" TextColor="#6A7B8C" FontSize="12"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#A23C2A" StrokeShape="RoundRectangle 12" Padding="10,4" VerticalOptions="Center">
                                <Label Text="ADMIN" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Site User Account Option Card -->
                    <Border Stroke="#EAEFF5" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16, 12">
                       <!--" <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnUserSelected" />
                        </Border.GestureRecognizers> -->
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Site User Demo — T. Mahlangu" TextColor="#0B1B2B" FontSize="14" FontAttributes="Bold"/>
                                <Label Text="Complete forms, view projects, search records" TextColor="#6A7B8C" FontSize="12"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#0C2340" StrokeShape="RoundRectangle 12" Padding="12,4" VerticalOptions="Center">
                                <Label Text="USER" TextColor="White" FontSize="10" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                    
                    
                    <!-- Informational Subtext Footer -->
                    <Label Text="This demo signs you in as one of two roles to show role-based access. A production deployment would use Supabase Auth with real accounts." 
                               TextColor="#9AABB8" 
                               FontSize="11"
                               LineHeight="1.3"
                               Margin="0,4,0,0"/>
                </VerticalStackLayout>    
                
                
            </Border>
        </Border>
        
    </Grid>

</ContentPage>
