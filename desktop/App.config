<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <appSettings>
        <!--
          PLACEHOLDER credentials for the login screen. Replace LoginForm.Authenticate
          with a real identity provider before this goes anywhere near production.
          Login.PasswordSha256 is an unsalted SHA-256 hex digest, which is NOT adequate
          for storing real passwords.
          The value below is the hash of: Mzukulu@2026
        -->
        <add key="Login.Username" value="admin" />
        <add key="Login.PasswordSha256" value="694d59877b0e1176fc11ff87b52095b4e4defec01b2361678a28a9fcd914e241" />
    </appSettings>
</configuration>
